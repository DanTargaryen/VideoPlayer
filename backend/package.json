{
  "name": "backend",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "build": "nest build",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "jest --config jest.config.cjs --runInBand --testPathIgnorePatterns=agent-ai.e2e-spec.ts --testPathIgnorePatterns=integration-api.e2e-spec.ts",
    "pretest:api": "node -e \"require('node:fs').mkdirSync('../test-results',{recursive:true})\"",
    "test:api": "jest --config jest.config.cjs --runInBand test/integration-api.e2e-spec.ts --json --outputFile=../test-results/integration-api-latest.json",
    "pretest:agent-ai": "node -e \"require('node:fs').mkdirSync('../test-results',{recursive:true})\"",
    "test:agent-ai": "jest --config jest.config.cjs --runInBand test/agent-ai.e2e-spec.ts --json --outputFile=../test-results/agent-ai-latest.json",
    "test:watch": "jest --config jest.config.cjs --watch --testPathIgnorePatterns=agent-ai.e2e-spec.ts --testPathIgnorePatterns=integration-api.e2e-spec.ts",
    "test:coverage": "jest --config jest.config.cjs --coverage --runInBand --testPathIgnorePatterns=agent-ai.e2e-spec.ts --testPathIgnorePatterns=integration-api.e2e-spec.ts",
    "prisma:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.js",
    "seed:demo-engagement": "node prisma/seed-demo-engagement.js",
    "seed:demo-engagement:clean": "node prisma/seed-demo-engagement.js --clean",
    "seed:demo-dynamic-feed": "node prisma/seed-demo-dynamic-feed.js",
    "seed:demo-dynamic-feed:clean": "node prisma/seed-demo-dynamic-feed.js --clean",
    "seed:demo-dynamic-feed:sync": "node prisma/seed-demo-dynamic-feed.js --sync-only"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/websockets": "^11.0.1",
    "@prisma/client": "^6.9.0",
    "@types/multer": "^2.1.0",
    "@types/nodemailer": "^8.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "minio": "^8.0.7",
    "nodemailer": "^8.0.5",
    "prisma": "^6.9.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.19",
    "@nestjs/schematics": "^11.0.1",
    "@nestjs/testing": "^11.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.14.0",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.23.0",
    "jest": "^30.4.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "typescript": "^5.8.2"
  }
}
