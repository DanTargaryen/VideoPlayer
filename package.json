{
  "name": "video-player-workspace",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "overrides": {
    "picomatch": "^4.0.4"
  },
  "scripts": {
    "dev": "bash ./scripts/dev.sh",
    "dev:lan": "bash ./scripts/dev-lan.sh",
    "dev:down": "bash ./scripts/dev-down.sh",
    "db:init": "bash ./scripts/init-db.sh",
    "db:migrate": "npm --workspace backend run prisma:generate && npm --workspace backend run db:migrate",
    "db:baseline-existing": "npm --workspace backend run db:baseline-existing",
    "db:seed": "npm --workspace backend run db:seed",
    "db:test-reset": "npm --workspace backend run db:test-reset",
    "migrate": "npm run db:migrate",
    "seed": "npm run db:seed",
    "test-reset": "npm run db:test-reset",
    "dev:frontend": "npm --workspace frontend run dev",
    "dev:backend": "npm --workspace backend run start:dev",
    "build:frontend": "npm --workspace frontend run build",
    "build:backend": "npm --workspace backend run build",
    "lint:frontend": "npm --workspace frontend run lint",
    "lint:backend": "npm --workspace backend run lint",
    "test": "npm run test:backend && npm run test:frontend",
    "test:requirements": "node test/run-unit-tests.js",
    "test:backend": "npm --workspace backend run test",
    "test:api": "npm --workspace backend run test:api",
    "test:agent-ai": "npm --workspace backend run test:agent-ai",
    "test:frontend": "npm --workspace frontend run test",
    "test:e2e": "playwright test",
    "test:ci": "npm run test:requirements && npm run lint:backend && npm run lint:frontend && npm run build:backend && npm run build:frontend && npm test"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "typescript-eslint": "^8.58.2"
  }
}
