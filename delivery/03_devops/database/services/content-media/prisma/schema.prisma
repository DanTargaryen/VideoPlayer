generator client {
  provider      = "prisma-client-js"
  output        = "../generated/prisma-client"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("CONTENT_DATABASE_URL")
}

model Video {
  id                        String               @id @default(cuid())
  creatorId                 String
  categoryId                String?
  title                     String
  description               String               @db.Text
  status                    VideoStatus          @default(DRAFT)
  coverUrl                  String?              @db.VarChar(255)
  playUrl                   String?              @db.VarChar(255)
  durationSeconds           Int                  @default(0)
  playCount                 Int                  @default(0)
  likeCount                 Int                  @default(0)
  favoriteCount             Int                  @default(0)
  commentCount              Int                  @default(0)
  coinCount                 Int                  @default(0)
  legacyUploadToken         String?              @unique @db.VarChar(255)
  legacyCategory            String?              @db.VarChar(32)
  tags                      Json?
  publishedAt               DateTime?
  submittedAt               DateTime?
  reviewSubmissionRequestId String?              @unique @db.VarChar(128)
  reviewDecisionId          String?              @unique
  reviewDecision            String?
  reviewDecisionReason      String?              @db.Text
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt
  assets                    VideoAsset[]
  comments                  Comment[]
  likes                     VideoLike[]
  favorites                 Favorite[]
  danmaku                   VideoDanmaku[]
  watches                   UserVideoWatch[]
  aiSummaries               VideoAiSummary[]
  aiChatSessions            VideoAiChatSession[]
  category                  VideoCategory?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([creatorId])
  @@index([status, publishedAt])
  @@index([categoryId])
}

model VideoCategory {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  videos    Video[]
}

model VideoAsset {
  id           String    @id @default(cuid())
  videoId      String?
  uploaderId   String?
  kind         AssetKind
  bucket       String    @db.VarChar(64)
  objectKey    String    @unique @db.VarChar(255)
  requestId    String?   @unique
  mimeType     String    @db.VarChar(128)
  originalName String?   @db.VarChar(255)
  url          String    @db.VarChar(255)
  sizeBytes    BigInt?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  video        Video?    @relation(fields: [videoId], references: [id], onDelete: SetNull)

  @@index([videoId])
  @@index([uploaderId, createdAt])
}

model UserVideoWatch {
  id                        String    @id @default(cuid())
  userId                    String
  videoId                   String
  progressSeconds           Int       @default(0)
  completed                 Boolean   @default(false)
  playCount                 Int       @default(0)
  totalWatchDurationSeconds Int       @default(0)
  lastWatchDurationSeconds  Int       @default(0)
  videoDurationSeconds      Int       @default(0)
  maxWatchRatio             Float     @default(0)
  lastWatchRatio            Float     @default(0)
  completedCount            Int       @default(0)
  lastWatchedAt             DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
  video                     Video     @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
  @@index([videoId])
}

model Comment {
  id         String     @id @default(cuid())
  videoId    String
  userId     String
  parentId   String?
  rootId     String?
  body       String     @db.Text
  imageUrl   String?    @db.VarChar(255)
  status     TextStatus @default(VISIBLE)
  replyCount Int        @default(0)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  video      Video      @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([videoId, status])
  @@index([videoId, parentId, createdAt])
  @@index([userId])
}

model VideoLike {
  id        String   @id @default(cuid())
  videoId   String
  userId    String
  requestId String?
  createdAt DateTime @default(now())
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([videoId, userId])
  @@unique([requestId])
  @@index([userId])
}

model FavoriteFolder {
  id        String     @id @default(cuid())
  userId    String
  name      String
  isDefault Boolean    @default(false)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  favorites Favorite[]

  @@unique([userId, name])
  @@index([userId, isDefault])
}

model Favorite {
  id        String          @id @default(cuid())
  userId    String
  videoId   String
  folderId  String?
  requestId String?
  createdAt DateTime        @default(now())
  video     Video           @relation(fields: [videoId], references: [id], onDelete: Cascade)
  folder    FavoriteFolder? @relation(fields: [folderId], references: [id])

  @@unique([videoId, userId])
  @@unique([requestId])
  @@index([userId])
  @@index([folderId])
}

model VideoDanmaku {
  id            String     @id @default(cuid())
  videoId       String
  userId        String
  body          String     @db.VarChar(255)
  offsetSeconds Int
  timeOffsetMs  Int        @default(0)
  color         String     @default("#FFFFFF") @db.VarChar(16)
  status        TextStatus @default(VISIBLE)
  createdAt     DateTime   @default(now())
  video         Video      @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([videoId, status])
  @@index([videoId, timeOffsetMs, createdAt])
  @@index([userId])
}

model CreatorPlayDaily {
  id        String   @id @default(cuid())
  creatorId String
  date      DateTime @db.Date
  plays     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([creatorId, date])
}

model VideoAiSummary {
  id         String   @id @default(cuid())
  videoId    String   @unique
  summary    String   @db.Text
  status     String   @default("READY")
  frameCount Int      @default(0)
  model      String?  @db.VarChar(64)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  video      Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
}

model VideoAiChatSession {
  id        String               @id @default(cuid())
  videoId   String
  userId    String
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  video     Video                @relation(fields: [videoId], references: [id], onDelete: Cascade)
  messages  VideoAiChatMessage[]

  @@unique([userId, videoId])
  @@index([videoId])
  @@index([userId])
}

model VideoAiChatMessage {
  id         String             @id @default(cuid())
  sessionId  String
  role       String
  content    String             @db.Text
  model      String?            @db.VarChar(64)
  frameCount Int?
  createdAt  DateTime           @default(now())
  session    VideoAiChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model ContentWriteReceipt {
  requestId  String   @id @db.VarChar(128)
  operation  String   @db.VarChar(64)
  actorId    String?
  resourceId String
  payload    Json
  result     Json
  createdAt  DateTime @default(now())

  @@index([operation, createdAt])
}

model NotificationOutbox {
  id          String    @id @default(cuid())
  requestId   String    @unique @db.VarChar(128)
  recipientId String
  actorId     String?
  type        String    @db.VarChar(32)
  title       String    @db.VarChar(128)
  content     String    @db.Text
  relatedType String?   @db.VarChar(32)
  relatedId   String?
  status      String    @default("PENDING") @db.VarChar(16)
  attempts    Int       @default(0)
  lastError   String?   @db.Text
  nextRetryAt DateTime  @default(now())
  deliveredAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, nextRetryAt])
}

model ContentIdSequence {
  name      String   @id @db.VarChar(64)
  nextId    BigInt
  updatedAt DateTime @updatedAt
}

enum VideoStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  HIDDEN
}

enum AssetKind {
  ORIGINAL
  TRANSCODED
  COVER
  REPLAY
}

enum TextStatus {
  VISIBLE
  HIDDEN
  DELETED
}
