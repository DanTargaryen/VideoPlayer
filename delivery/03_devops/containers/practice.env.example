# Copy to .env.practice and replace every placeholder before running Compose.
# Never commit .env.practice or real credentials.

MYSQL_ROOT_PASSWORD=replace-with-local-mysql-password
MINIO_ROOT_USER=replace-with-local-minio-user
MINIO_ROOT_PASSWORD=replace-with-local-minio-password
JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_SECRET=replace-with-local-admin-secret
SERVICE_JWT_SECRET=replace-with-at-least-32-random-characters
IDENTITY_DATABASE_NAME=video_player_identity_test
IDENTITY_DATABASE_USER=identity_app
IDENTITY_DATABASE_PASSWORD=replace-with-url-safe-local-identity-password
IDENTITY_DATABASE_URL=mysql://identity_app:replace-with-url-safe-local-identity-password@mysql:3306/video_player_identity_test
IDENTITY_ADMIN_SECRET=replace-with-at-least-32-random-characters
LIVE_REWARD_DATABASE_NAME=video_player_live_reward_test
LIVE_REWARD_DATABASE_USER=live_reward
LIVE_REWARD_DATABASE_PASSWORD=replace-with-url-safe-local-live-reward-password
LIVE_REWARD_DATABASE_URL=mysql://live_reward:replace-with-url-safe-local-live-reward-password@mysql:3306/video_player_live_reward_test
GOVERNANCE_DATABASE_NAME=video_player_governance_test
GOVERNANCE_DATABASE_USER=governance_app
GOVERNANCE_DATABASE_PASSWORD=replace-with-url-safe-local-governance-password
GOVERNANCE_DATABASE_URL=mysql://governance_app:replace-with-url-safe-local-governance-password@mysql:3306/video_player_governance_test
