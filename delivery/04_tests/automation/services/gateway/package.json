{
  "name": "@videoplayer/gateway",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "prebuild": "npm --workspace @videoplayer/shared-contracts run build",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "pretest": "npm --workspace @videoplayer/shared-contracts run build",
    "test": "vitest run --config vitest.config.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@videoplayer/shared-contracts": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "eslint": "^9.23.0",
    "typescript": "^5.8.2",
    "vitest": "^4.1.11"
  }
}
